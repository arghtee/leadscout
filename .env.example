# --- Core ---
DATABASE_URL=postgresql+psycopg://leadscout:leadscout@localhost:5432/leadscout
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# --- Optional seed / signal adapters (M4) ---
GOOGLE_PLACES_API_KEY=
COMPANIES_HOUSE_API_KEY=
META_GRAPH_TOKEN=

# --- RocketReach MCP (M3/M5) ---
ROCKETREACH_MCP_URL=https://mcp.rocketreach.co/mcp
# OAuth client / key per RocketReach docs
ROCKETREACH_AUTH=
MIN_CREDIT_BALANCE=
MAX_CREDITS_PER_RUN=
MAX_CONTACTS_PER_COMPANY=2
LOOKUP_POLL_TIMEOUT_S=120

# --- LLM (M8) ---
# anthropic | openai
LLM_PROVIDER=anthropic
LLM_API_KEY=

# --- Google OAuth for Sheets / Gmail (M8/M9) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Compliance / sending ---
# required in email footer
SENDER_POSTAL_ADDRESS=
MAX_SPEND_PER_RUN=
DAILY_SEND_CAP=30
